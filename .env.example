# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/velours_db?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="generate_a_random_32_char_string"
NEXTAUTH_URL="http://localhost:3000"

# Midtrans Configuration (Sandbox for development)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-..."
MIDTRANS_SERVER_KEY="SB-Mid-server-..."
MIDTRANS_IS_PRODUCTION="false"

# AI Configuration (Gemini)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# SMTP Email Notification Configuration (Gmail / Mailtrap / Resend / Brevo)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Velours Patisserie <noreply@velourspatisserie.web.id>"
